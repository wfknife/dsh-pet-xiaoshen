{
  "appId": "com.deskpet.xiaoshen-clean",
  "productName": "桌宠小深纯净版",
  "directories": {
    "output": "dist-clean"
  },
  "publish": {
    "provider": "generic",
    "url": "https://example.com/updates"
  },
  "files": [
    "build/version-compare.js",
    "custom-model-store.cjs",
    "dsh-compat.js",
    "dsh-lifecycle.js",
    "main.js",
    "model-candidate.js",
    "model-config.cjs",
    "model-provider.cjs",
    "model-registry.js",
    "model-validator-real.js",
    "model-validator.js",
    "official-harness.js",
    "pet-life-store.cjs",
    "platform-domain.cjs",
    "platform-packages.cjs",
    "platform-store.cjs",
    "platform-worker.cjs",
    "preload.js",
    "prompt-defaults.json",
    "prompt-store.cjs",
    "state-store.cjs",
    "update-manager.js",
    "userdata-isolation.js",
    "renderer/**/*",
    "!renderer/prompt-manager*",
    "!renderer/prompt-workflows.js",
    "!prompt-manager*",
    "!prompt-sample-runner.cjs",
    "package.json",
    "trusted-extensions/**/*",
    "!node_modules/electron-updater/**",
    "!node_modules/elevate/**",
    "character/**/*"
  ],
  "asarUnpack": [
    "node_modules/koffi/**",
    "node_modules/ws/**",
    "node_modules/better-sqlite3/**"
  ],
  "extraResources": [
    {
      "from": "build/icon.ico",
      "to": "icon.ico"
    },
    {
      "from": "build/clean-edition.json",
      "to": "clean-edition.json"
    },
    {
      "from": "build/daily-collector.json",
      "to": "daily-collector.json"
    }
  ],
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "桌宠小深纯净版",
    "include": "build/installer.nsh",
    "artifactName": "deskpet-setup-clean-${version}.${ext}"
  },
  "artifactName": "deskpet-setup-clean-${version}.${ext}",
  "npmRebuild": false,
  "beforePack": "./build/prepare-native.cjs"
}
