{
  "appId": "com.deskpet.xiaoshen",
  "productName": "桌宠小深",
  "directories": {
    "output": "dist/release"
  },
  "files": [
    "main.js",
    "state-store.cjs",
    "custom-model-store.cjs",
    "pet-life-store.cjs",
    "official-harness.js",
    "preload.js",
    "dsh-compat.js",
    "model-registry.js",
    "model-candidate.js",
    "model-validator.js",
    "model-validator-real.js",
    "dsh-lifecycle.js",
    "userdata-isolation.js",
    "update-manager.js",
    "build/version-compare.js",
    "renderer/**/*",
    "!renderer/prompt-manager*",
    "!renderer/prompt-workflows.js",
    "!prompt-manager*",
    "!prompt-sample-runner.cjs",
    "package.json",
    "prompt-store.cjs",
    "prompt-defaults.json",
    "platform-store.cjs",
    "platform-domain.cjs",
    "platform-packages.cjs",
    "platform-worker.cjs",
    "trusted-extensions/**/*",
    "model-config.cjs",
    "model-provider.cjs",
    "character/**/*"
  ],
  "asarUnpack": [
    "node_modules/koffi/**",
    "node_modules/ws/**",
    "node_modules/better-sqlite3/**"
  ],
  "extraResources": [
    {
      "from": "build/icon.ico",
      "to": "icon.ico"
    }
  ],
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "桌宠小深",
    "include": "build/installer.nsh",
    "artifactName": "deskpet-setup-${version}.${ext}"
  },
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "beforePack": "./build/prepare-native.cjs"
}
