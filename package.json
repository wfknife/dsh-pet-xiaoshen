{
  "name": "deskpet",
  "version": "2.0.0-rc.6",
  "private": true,
  "description": "Desktop companion for DSH with configurable AI model services",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:release": "electron-builder --win --config build/electron-builder-release.json",
    "native:prepare": "node build/prepare-native.cjs",
    "postinstall": "node build/prepare-native.cjs"
  },
  "build": {
    "appId": "com.deskpet.xiaoshen",
    "productName": "桌宠小深",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "generic",
      "url": "https://example.com/updates"
    },
    "files": [
      "main.js",
      "state-store.cjs",
      "custom-model-store.cjs",
      "pet-life-store.cjs",
      "official-harness.js",
      "preload.js",
      "dsh-compat.js",
      "model-registry.js",
      "model-candidate.js",
      "model-validator.js",
      "model-validator-real.js",
      "dsh-lifecycle.js",
      "userdata-isolation.js",
      "update-manager.js",
      "build/version-compare.js",
      "renderer/**/*",
      "!renderer/prompt-manager*",
      "!renderer/prompt-workflows.js",
      "!prompt-manager*",
      "!prompt-sample-runner.cjs",
      "package.json",
      "prompt-store.cjs",
      "prompt-defaults.json",
      "platform-store.cjs",
      "platform-domain.cjs",
      "platform-packages.cjs",
      "platform-worker.cjs",
      "character/**/*",
      "trusted-extensions/**/*",
      "model-config.cjs",
      "model-provider.cjs"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/ws/**",
      "node_modules/better-sqlite3/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "桌宠小深",
      "include": "build/installer.nsh",
      "artifactName": "deskpet-setup-${version}.${ext}"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "beforePack": "./build/prepare-native.cjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.5",
    "semver": "6.3.1",
    "ws": "^8.21.3"
  }
}
